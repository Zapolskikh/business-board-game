# Simulation output. The reports are regenerated by `simulation.cli` and `simulation.suite`,
# which overwrite them silently — keeping them tracked meant every run dirtied the tree with
# numbers measured against whatever rules happened to be checked out.
backend/out/
SIMULATION_RESULTS_*.md
# Same for the per-item balance reports from `python -m simulation.balance`: one measurement of one
# ruleset, regenerated on every run. The plan that interprets them is BALANCE_TESTING_PLAN.md, which
# is tracked; the numbers are not.
balance-runs/

# Exported playtest journals. Same reasoning as the simulation reports: they are a record of one
# match under one set of rules, they land in the repo root every time a game is exported, and the
# numbers in them stop matching the code the moment the balance moves.
city-of-influence-*.md
city-of-influence-*.json

# Agent-play sessions, catalog cache and command journals (contain room passwords)
.agent_play/
.agent_play*/
arena/

